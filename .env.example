# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Required)
# ------------------------------------------------------------------------------
# We use PostgreSQL with the pgvector extension. 
# This URL points to the Docker Compose service 'db'.
DATABASE_URL=postgresql://postgres:postgres@db:5432/lennyapp

# ------------------------------------------------------------------------------
# 2. Cloud LLM Providers
# ------------------------------------------------------------------------------
# The API key for Anthropic Claude (e.g., claude-3-5-sonnet-20240620).
ANTHROPIC_API_KEY=

# The API key for OpenAI (used for GPT-4o).
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 3. Local LLM Configuration (Ollama - Required for Demo)
# ------------------------------------------------------------------------------
# URL to connect to Ollama. 
# Use http://host.docker.internal:11434 to reach Ollama running on the host machine from inside Docker.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Which model to use for local generation (e.g., llama3.1, mistral, or qwen2.5)
OLLAMA_MODEL=llama3.1

# ------------------------------------------------------------------------------
# 4. Server & Logging Configuration
# ------------------------------------------------------------------------------
# FastAPI Backend Port
PORT=8000

# Allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
